<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="App_v3.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:App_v3.Views"
    Title="Seguimiento académico">

    <!-- Materia/comisión fijas arriba en todas las páginas; Reportes y Configuración son rutas, no pestañas -->
    <Shell.TitleView>
        <views:BarraGlobalView x:Name="Barra" />
    </Shell.TitleView>

    <TabBar>
        <Tab Title="Seguimiento" Route="Seguimiento">
            <ShellContent ContentTemplate="{DataTemplate views:SeguimientoPage}" />
        </Tab>
        <Tab Title="Estudiantes" Route="Estudiantes">
            <ShellContent ContentTemplate="{DataTemplate views:EstudiantesPage}" />
        </Tab>
        <Tab Title="Materias" Route="Materias">
            <ShellContent ContentTemplate="{DataTemplate views:MateriasPage}" />
        </Tab>
        <Tab Title="Calendario" Route="Calendario">
            <ShellContent ContentTemplate="{DataTemplate views:CalendarioPage}" />
        </Tab>
        <Tab Title="Asistencia" Route="Asistencia">
            <ShellContent ContentTemplate="{DataTemplate views:AsistenciaPage}" />
        </Tab>
        <Tab Title="Entregas" Route="Entregas">
            <ShellContent ContentTemplate="{DataTemplate views:EntregasPage}" />
        </Tab>
    </TabBar>
</Shell>