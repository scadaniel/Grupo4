<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="App_v3.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:App_v3.Views"
    Title="Sistema de Alerta Temprana"
    FlyoutBehavior="Flyout">

    <!-- Cabecera del Menú Lateral -->
    <Shell.FlyoutHeader>
        <VerticalStackLayout BackgroundColor="#1E293B" Padding="20,30,20,20" Spacing="5">
            <Label Text="Sistema de Alerta" 
                   TextColor="White" 
                   FontSize="20" 
                   FontAttributes="Bold" />
            <Label Text="Panel de Gestión" 
                   TextColor="#94A3B8" 
                   FontSize="14" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <!-- PANTALLA DE BIENVENIDA INICIAL (Se muestra al abrir la app) -->
    <ShellContent 
        Title="Inicio"
        Route="WelcomePage"
        ContentTemplate="{DataTemplate views:WelcomePage}"
        FlyoutItemIsVisible="False" />

    <!-- DEMÁS MÓDULOS DEL MENÚ LATERAL -->
    <FlyoutItem Title="Personas" Icon="dotnet_bot.png">
        <ShellContent ContentTemplate="{DataTemplate views:GestionPersonasPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Alumnos" Icon="dotnet_bot.png">
        <ShellContent ContentTemplate="{DataTemplate views:EstudianteListPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Clases" Icon="dotnet_bot.png">
        <ShellContent ContentTemplate="{DataTemplate views:GestionClasesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Calendario" Icon="dotnet_bot.png">
        <ShellContent ContentTemplate="{DataTemplate views:CalendarPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Asistencia" Icon="dotnet_bot.png">
        <ShellContent ContentTemplate="{DataTemplate views:AttendancePage}" />
    </FlyoutItem>

    <FlyoutItem Title="Entregas TP" Icon="dotnet_bot.png">
        <ShellContent ContentTemplate="{DataTemplate views:RegistroEntregasPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Reportes" Icon="dotnet_bot.png">
        <ShellContent ContentTemplate="{DataTemplate views:MenuReportesPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Configuración" Icon="dotnet_bot.png">
        <ShellContent ContentTemplate="{DataTemplate views:ConfiguracionPage}" />
    </FlyoutItem>

    <!-- PIE DE PÁGINA DEL MENÚ LATERAL (GRUPO 4) -->
    <Shell.FlyoutFooter>
        <VerticalStackLayout BackgroundColor="#0F172A" Padding="20,15" Spacing="4">
            <Label Text="GRUPO 4" 
                   TextColor="#38BDF8" 
                   FontSize="13" 
                   FontAttributes="Bold" 
                   HorizontalTextAlignment="Center"/>
            <Label Text="Eleonora, Mariana, Alan, Julio, Daniel" 
                   TextColor="#94A3B8" 
                   FontSize="11" 
                   HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

</Shell>