<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App_v3.Views.EstadoVacioView">
    <Border Style="{StaticResource Tarjeta}" IsVisible="{Binding SinComision}">
        <VerticalStackLayout Spacing="8">
            <Label Text="Falta elegir una comisión" Style="{StaticResource TituloTarjeta}" />
            <Label Text="Cree una materia y una comisión para empezar, o elíjalas arriba." Style="{StaticResource Detalle}" />
            <Button Text="Ir a Materias" HorizontalOptions="Start" Clicked="AlIrAMaterias" />
        </VerticalStackLayout>
    </Border>
</ContentView>