<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:App_v3.Views"
    xmlns:conv="clr-namespace:App_v3.Converters"
             x:Class="App_v3.Views.SelectorComisionView">
    <Border Style="{StaticResource Tarjeta}">
        <VerticalStackLayout Spacing="6">
            <Label Text="{Binding Resumen}" Style="{StaticResource Detalle}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Picker Grid.Column="0" Title="Materia"
                        ItemsSource="{Binding Materias}"
                        ItemDisplayBinding="{Binding Nombre}"
                        SelectedItem="{Binding MateriaSeleccionada}" />
                <Picker Grid.Column="1" Title="Comisión"
                        ItemsSource="{Binding Comisiones}"
                        ItemDisplayBinding="{Binding Nombre}"
                        SelectedItem="{Binding ComisionSeleccionada}" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>
