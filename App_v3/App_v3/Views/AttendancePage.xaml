<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:App_v3.ViewModels"
             x:Class="App_v3.Views.AttendancePage"
             Title="Control de Asistencia"
             BackgroundColor="#0F172A"
             Shell.NavBarIsVisible="False">

    <!-- Grid principal dividido en Barra Superior (Fila 0) y Contenido (Fila 1) -->
    <Grid RowDefinitions="Auto, *">

        <!-- ⭐ BARRA SUPERIOR PERSONALIZADA CON BOTÓN MENÚ -->
        <Grid Grid.Row="0" 
              BackgroundColor="#1E293B" 
              Padding="20,15" 
              ColumnDefinitions="Auto, *, Auto">

            <Button Grid.Column="0"
                    Text="☰ Menú" 
                    BackgroundColor="#3B82F6" 
                    TextColor="White"
                    FontSize="18"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="50"
                    WidthRequest="120"
                    VerticalOptions="Center"
                    Clicked="OnBotonMenuFlyoutClicked" />

            <Label Grid.Column="1" 
                   Text="Control de Asistencia" 
                   TextColor="White" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center" 
                   Margin="20,0,0,0" />
        </Grid>

        <!-- CONTENIDO SCROLLABLE -->
        <ScrollView Grid.Row="1" BackgroundColor="#F4F6F9">
            <VerticalStackLayout Padding="20" Spacing="15">

                <!-- Encabezado y Selección de Clase / Comisión -->
                <Frame BorderColor="#E0E0E0" CornerRadius="10" Padding="15" HasShadow="True" BackgroundColor="White">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Seleccionar Comisión" 
                               FontSize="14" 
                               FontAttributes="Bold" 
                               TextColor="#2C3E50" />

                        <Picker ItemDisplayBinding="{Binding Comision}"
                                ItemsSource="{Binding ComisionesList}"
                                SelectedItem="{Binding ClaseSeleccionada}"
                                Title="Elija una comisión..."
                                FontSize="15"
                                BackgroundColor="#FFFFFF" />

                        <Label Text="Fecha de Asistencia" 
                               FontSize="14" 
                               FontAttributes="Bold" 
                               TextColor="#2C3E50" 
                               Margin="0,5,0,0" />

                        <DatePicker Date="{Binding FechaSeleccionada}"
                                    FontSize="15" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Sección de Búsqueda y Alta Rápida por DNI -->
                <Frame BorderColor="#E0E0E0" CornerRadius="10" Padding="15" HasShadow="True" BackgroundColor="White">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Inscribir Alumno por DNI" 
                               FontSize="14" 
                               FontAttributes="Bold" 
                               TextColor="#2C3E50" />

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                            <Entry Grid.Column="0"
                                   Placeholder="Ingrese DNI del alumno..."
                                   Text="{Binding DniIngresado}"
                                   Keyboard="Numeric" />
                            <Button Grid.Column="1"
                                    Text="Buscar"
                                    Command="{Binding BuscarAlumnoCommand}"
                                    BackgroundColor="#455A64"
                                    TextColor="White" />
                        </Grid>

                        <!-- Vista previa del alumno encontrado -->
                        <VerticalStackLayout IsVisible="{Binding IsAlumnoEncontradoVisible}" Spacing="5" Margin="0,5,0,0">
                            <Label Text="{Binding NombreAlumnoEncontrado}" 
                                   FontSize="13" 
                                   TextColor="#37474F" />
                            <Button Text="Inscribir a esta clase"
                                    Command="{Binding InscribirAlumnoCommand}"
                                    BackgroundColor="#2E7D32"
                                    TextColor="White"
                                    FontSize="13"
                                    HeightRequest="40" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Titulo de la lista -->
                <Label Text="Nómina de Estudiantes" 
                       FontSize="18" 
                       FontAttributes="Bold" 
                       TextColor="#1A252C" 
                       Margin="0,5,0,0" />

                <!-- Lista de Alumnos con los 3 Checkboxes y 4 Columnas -->
                <CollectionView ItemsSource="{Binding AlumnosAsistencia}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BorderColor="#EFEFEF" 
                                   CornerRadius="8" 
                                   Padding="10" 
                                   Margin="0,4" 
                                   HasShadow="False" 
                                   BackgroundColor="White">

                                <Grid ColumnDefinitions="*, Auto, Auto, Auto" ColumnSpacing="8" VerticalOptions="Center">

                                    <!-- Info Alumno -->
                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                        <Label Text="{Binding NombreCompleto}" 
                                               FontAttributes="Bold" 
                                               FontSize="14" 
                                               TextColor="#212121" />
                                        <Label Text="{Binding Legajo, StringFormat='Legajo: {0}'}" 
                                               FontSize="11" 
                                               TextColor="#757575" />
                                    </VerticalStackLayout>

                                    <!-- Presente -->
                                    <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="Pres." FontSize="11" VerticalOptions="Center" TextColor="#2E7D32" />
                                        <CheckBox IsChecked="{Binding EstaPresente}" Color="#2E7D32" />
                                    </HorizontalStackLayout>

                                    <!-- Ausente -->
                                    <HorizontalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                                        <Label Text="Aus." FontSize="11" VerticalOptions="Center" TextColor="#D32F2F" />
                                        <CheckBox IsChecked="{Binding EstaAusente}" Color="#D32F2F" />
                                    </HorizontalStackLayout>

                                    <!-- Justificada -->
                                    <HorizontalStackLayout Grid.Column="3" VerticalOptions="Center" Spacing="2">
                                        <Label Text="Just." FontSize="11" VerticalOptions="Center" TextColor="#F57C00" />
                                        <CheckBox IsChecked="{Binding Justificada}" Color="#F57C00" />
                                    </HorizontalStackLayout>

                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Botón de Guardado General -->
                <Button Text="Guardar Asistencia"
                        Command="{Binding GuardarAsistenciaCommand}"
                        BackgroundColor="#1976D2"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="50"
                        Margin="0,10,0,20" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>