<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App_v3.Views.AttendancePage"
             Title="Control de Asistencia"
             BackgroundColor="#0F172A"
             Shell.NavBarIsVisible="False">

    <!-- Grid principal dividido en Barra Superior (Fila 0) y Contenido (Fila 1) -->
    <Grid RowDefinitions="Auto, *">

        <!-- 🌟 BARRA SUPERIOR PERSONALIZADA CON BOTÓN MENÚ -->
        <Grid Grid.Row="0" 
              BackgroundColor="#1E293B" 
              Padding="20,15" 
              ColumnDefinitions="Auto, *, Auto">

            <Button Grid.Column="0"
                    Text="☰  Menú" 
                    BackgroundColor="#3B82F6" 
                    TextColor="White"
                    FontSize="18"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="50"
                    WidthRequest="120"
                    VerticalOptions="Center"
                    Clicked="OnBotonMenuFlyoutClicked" />

            <Label Grid.Column="1" 
                   Text="Control de Asistencia" 
                   TextColor="White" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center" 
                   Margin="20,0,0,0" />
        </Grid>

        <!-- CONTENIDO SCROLLABLE PARA EL CONTROL DE ASISTENCIA -->
        <ScrollView Grid.Row="1" BackgroundColor="#F4F6F9">
            <Grid RowDefinitions="Auto, Auto, Auto, Auto, *, Auto" Padding="20" RowSpacing="10">

                <!-- Título Interno -->
                <Label Grid.Row="0" 
                       Text="Control de Asistencia" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       TextColor="#1A252C" />

                <!-- Selección de Comisión / Clase -->
                <VerticalStackLayout Grid.Row="1" Spacing="4">
                    <Label Text="Seleccionar Clase / Comisión:" FontAttributes="Bold" TextColor="#1A252C" />
                    <Picker ItemsSource="{Binding ComisionesList}"
                            SelectedItem="{Binding ClaseSeleccionada}"
                            ItemDisplayBinding="{Binding DescripcionCompleta}"
                            Title="Elija una clase..." 
                            BackgroundColor="White" />
                </VerticalStackLayout>

                <!-- Fecha de la Toma de Asistencia (Por defecto Hoy de Windows) -->
                <VerticalStackLayout Grid.Row="2" Spacing="4">
                    <Label Text="Fecha de Toma de Asistencia:" FontAttributes="Bold" TextColor="#1A252C" />
                    <DatePicker Date="{Binding FechaSeleccionada}" BackgroundColor="White" />
                </VerticalStackLayout>

                <!-- Encabezado de la Lista de Alumnos -->
                <Label Grid.Row="3" 
                       Text="Nómina de Estudiantes" 
                       FontAttributes="Bold" 
                       FontSize="18" 
                       TextColor="#1A252C" />

                <!-- CollectionView: Vacío al arrancar hasta seleccionar clase -->
                <CollectionView Grid.Row="4" 
                                ItemsSource="{Binding AlumnosAsistencia}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,4" 
                                    Padding="10" 
                                    BackgroundColor="#FFFFFF" 
                                    Stroke="LightGray" 
                                    StrokeThickness="1" 
                                    StrokeShape="RoundRectangle 6">
                                <Grid ColumnDefinitions="*, Auto, Auto" VerticalOptions="Center">
                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                        <Label Text="{Binding NombreCompleto}" FontSize="16" FontAttributes="Bold" TextColor="#212121" />
                                        <Label Text="{Binding Legajo, StringFormat='Legajo: {0}'}" FontSize="12" TextColor="Gray" />
                                    </VerticalStackLayout>

                                    <!-- Controles de Presente / Justificada -->
                                    <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center" Margin="10,0">
                                        <Label Text="Presente" VerticalOptions="Center" FontSize="13" TextColor="#333333" />
                                        <CheckBox IsChecked="{Binding EstaPresente}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Botón de Guardado -->
                <Button Grid.Row="5"
                        Text="Guardar Asistencia" 
                        Command="{Binding GuardarAsistenciaCommand}" 
                        BackgroundColor="DarkGreen" 
                        TextColor="White" 
                        CornerRadius="8"
                        Margin="0,5,0,0" 
                        HeightRequest="45" />

            </Grid>
        </ScrollView>

    </Grid>
</ContentPage>