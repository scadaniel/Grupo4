<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:App_v3.ViewModels"
             x:Class="App_v3.Views.TomaAsistenciaPage"
             Title="Control de Asistencia"
             BackgroundColor="#F4F6F9">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Encabezado y Selección de Clase (H2 -> H3) -->
            <Frame BorderColor="#E0E0E0" CornerRadius="10" Padding="15" HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Seleccionar Clase / Fecha" 
                           FontSize="14" 
                           FontAttributes="Bold" 
                           TextColor="#2C3E50" />

                    <Picker ItemDisplayBinding="{Binding Tema}"
                            ItemsSource="{Binding Clases}"
                            SelectedItem="{Binding ClaseSeleccionada}"
                            Title="Elija una clase..."
                            FontSize="15"
                            BackgroundColor="#FFFFFF" />
                </VerticalStackLayout>
            </Frame>

            <!-- Titulo de la lista -->
            <Label Text="Nómina de Estudiantes" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   TextColor="#1A252C" 
                   Margin="0,10,0,0" />

            <!-- Lista de Alumnos -->
            <CollectionView ItemsSource="{Binding ListaAlumnos}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="#EFEFEF" 
                               CornerRadius="8" 
                               Padding="12" 
                               Margin="0,4" 
                               HasShadow="False" 
                               BackgroundColor="White">
                            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10" VerticalOptions="Center">

                                <!-- Info Alumno -->
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                    <Label Text="{Binding NombreEstudiante}" 
                                           FontAttributes="Bold" 
                                           FontSize="15" 
                                           TextColor="#212121" />
                                    <Label Text="{Binding Legajo, StringFormat='Legajo: {0}'}" 
                                           FontSize="12" 
                                           TextColor="#757575" />
                                </VerticalStackLayout>

                                <!-- Interruptor Presente/Ausente (H3) -->
                                <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                    <Label Text="Presente" FontSize="12" VerticalOptions="Center" />
                                    <CheckBox IsChecked="{Binding Presente}" Color="#2E7D32" />
                                </HorizontalStackLayout>

                                <!-- Interruptor Justificada (H4) -->
                                <HorizontalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="4">
                                    <Label Text="Justificada" FontSize="12" VerticalOptions="Center" TextColor="#D32F2F" />
                                    <CheckBox IsChecked="{Binding Justificada}" Color="#D32F2F" />
                                </HorizontalStackLayout>

                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Botón de Guardado -->
            <Button Text="Guardar Asistencia"
                    Command="{Binding GuardarAsistenciaCommand}"
                    BackgroundColor="#1976D2"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="50"
                    Margin="0,15,0,20" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>