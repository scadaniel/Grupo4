<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:App_v3.ViewModels"
             x:Class="App_v3.Views.RegistroEntregasPage"
             Title="Registro de Trabajos Prácticos"
             BackgroundColor="#0F172A"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">

        <!-- BARRA SUPERIOR -->
        <Grid Grid.Row="0"
              BackgroundColor="#1E293B"
              Padding="20,15"
              ColumnDefinitions="Auto, *, Auto">

            <Button Grid.Column="0"
                    Text="☰  Menú"
                    BackgroundColor="#3B82F6"
                    TextColor="White"
                    FontSize="18"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="50"
                    WidthRequest="120"
                    VerticalOptions="Center"
                    Clicked="OnBotonMenuFlyoutClicked" />

            <Label Grid.Column="1"
                   Text="Registro de TPs"
                   TextColor="White"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   Margin="20,0,0,0" />
        </Grid>

        <!-- CONTENIDO SCROLLABLE -->
        <ScrollView Grid.Row="1" BackgroundColor="#F4F6F9">
            <VerticalStackLayout Padding="20" Spacing="15">

                <!-- 1. Selección de Clase / Comisión -->
                <Frame BorderColor="#E0E0E0" CornerRadius="10" Padding="15" HasShadow="True" BackgroundColor="White">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Seleccionar Clase / Comisión"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#2C3E50" />

                        <Picker ItemsSource="{Binding Clases}"
                                SelectedItem="{Binding ClaseSeleccionada}"
                                Title="Elija una clase..."
                                FontSize="15"
                                BackgroundColor="#FFFFFF">
                            <Picker.ItemDisplayBinding>
                                <MultiBinding StringFormat="{}{0} - [{1}] (Clase #{2}: {3})">
                                    <Binding Path="NombreMateria" />
                                    <Binding Path="Comision" />
                                    <Binding Path="NumeroClase" />
                                    <Binding Path="Tema" />
                                </MultiBinding>
                            </Picker.ItemDisplayBinding>
                        </Picker>
                    </VerticalStackLayout>
                </Frame>

                <!-- 2. Crear Nuevo Trabajo Práctico en esta Comisión (¡Ahora arriba!) -->
                <Frame BorderColor="#3B82F6" CornerRadius="10" Padding="15" HasShadow="True" BackgroundColor="#F8FAFC">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="➕ Nuevo Trabajo Práctico para esta Comisión"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#1E3A8A" />

                        <Grid ColumnDefinitions="*, *, Auto" ColumnSpacing="10">
                            <Entry Grid.Column="0"
                                   Placeholder="Nombre del TP (ej: TP 1: Ley de Ohm)"
                                   Text="{Binding NuevoTpNombre}"
                                   BackgroundColor="White" />

                            <Entry Grid.Column="1"
                                   Placeholder="Descripción (opcional)"
                                   Text="{Binding NuevoTpDescripcion}"
                                   BackgroundColor="White" />

                            <Button Grid.Column="2"
                                    Text="Crear TP"
                                    Command="{Binding CrearTpCommand}"
                                    BackgroundColor="#2563EB"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="8"
                                    Padding="16,0"
                                    HeightRequest="44" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- 3. Selección y Eliminación de Trabajo Práctico (¡Ahora abajo!) -->
                <Frame BorderColor="#E0E0E0" CornerRadius="10" Padding="15" HasShadow="True" BackgroundColor="White">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Seleccionar Trabajo Práctico Existente"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#2C3E50" />

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                            <Picker Grid.Column="0"
                                    ItemDisplayBinding="{Binding Nombre}"
                                    ItemsSource="{Binding TrabajosPracticos}"
                                    SelectedItem="{Binding TpSeleccionado}"
                                    Title="Elija un TP..."
                                    FontSize="15"
                                    BackgroundColor="#FFFFFF" />

                            <Button Grid.Column="1"
                                    Text="🗑️ Eliminar TP"
                                    Command="{Binding EliminarTpCommand}"
                                    BackgroundColor="#DC2626"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="8"
                                    Padding="12,0"
                                    HeightRequest="44" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Título de la lista -->
                <Label Text="Control de Entregas por Alumno"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#1A252C"
                       Margin="0,10,0,0" />

                <!-- Lista de Alumnos Inscriptos -->
                <CollectionView ItemsSource="{Binding ListaAlumnos}">
                    <CollectionView.EmptyView>
                        <Label Text="No hay estudiantes inscriptos en esta comisión o debe seleccionar un TP."
                               HorizontalOptions="Center"
                               TextColor="Gray"
                               Margin="0,20" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BorderColor="#EFEFEF"
                                   CornerRadius="8"
                                   Padding="12"
                                   Margin="0,4"
                                   HasShadow="False"
                                   BackgroundColor="White">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" VerticalOptions="Center">

                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                        <Label Text="{Binding NombreEstudiante}"
                                               FontAttributes="Bold"
                                               FontSize="15"
                                               TextColor="#212121" />
                                        <Label Text="{Binding Legajo, StringFormat='Legajo: {0}'}"
                                               FontSize="12"
                                               TextColor="#757575" />
                                    </VerticalStackLayout>

                                    <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="6">
                                        <Label Text="Entregado" FontSize="12" VerticalOptions="Center" TextColor="#2E7D32" />
                                        <CheckBox IsChecked="{Binding Entregado}" Color="#2E7D32" />
                                    </HorizontalStackLayout>

                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Botón de Guardado -->
                <Button Text="Guardar Entregas de TPs"
                        Command="{Binding GuardarEntregasCommand}"
                        BackgroundColor="#1976D2"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="50"
                        Margin="0,15,0,20" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>