<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:App_v3.ViewModels"
             x:Class="App_v3.Views.RegistroEntregasPage"
             Title="Registro de Trabajos Prácticos"
             BackgroundColor="#F4F6F9">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Selección de Clase / Comisión -->
            <Frame BorderColor="#E0E0E0" CornerRadius="10" Padding="15" HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Seleccionar Clase / Comisión" 
                           FontSize="14" 
                           FontAttributes="Bold" 
                           TextColor="#2C3E50" />

                    <!-- Usamos ItemDisplayBinding apuntando directamente a una propiedad o dejamos que use el formato limpio -->
                    <Picker ItemsSource="{Binding Clases}"
                            SelectedItem="{Binding ClaseSeleccionada}"
                            Title="Elija una clase..."
                            FontSize="15"
                            BackgroundColor="#FFFFFF">
                        <Picker.ItemDisplayBinding>
                            <MultiBinding StringFormat="{}{0} - [{1}] (Clase #{2}: {3})">
                                <Binding Path="NombreMateria" />
                                <Binding Path="Comision" />
                                <Binding Path="NumeroClase" />
                                <Binding Path="Tema" />
                            </MultiBinding>
                        </Picker.ItemDisplayBinding>
                    </Picker>
                </VerticalStackLayout>
            </Frame>

            <!-- Selección de Trabajo Práctico -->
            <Frame BorderColor="#E0E0E0" CornerRadius="10" Padding="15" HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Seleccionar Trabajo Práctico" 
                           FontSize="14" 
                           FontAttributes="Bold" 
                           TextColor="#2C3E50" />

                    <Picker ItemDisplayBinding="{Binding Nombre}"
                            ItemsSource="{Binding TrabajosPracticos}"
                            SelectedItem="{Binding TpSeleccionado}"
                            Title="Elija un TP..."
                            FontSize="15"
                            BackgroundColor="#FFFFFF" />
                </VerticalStackLayout>
            </Frame>

            <!-- Título de la lista -->
            <Label Text="Control de Entregas por Alumno" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   TextColor="#1A252C" 
                   Margin="0,10,0,0" />

            <!-- Lista de Alumnos Inscriptos -->
            <CollectionView ItemsSource="{Binding ListaAlumnos}">
                <CollectionView.EmptyView>
                    <Label Text="No hay estudiantes inscriptos en esta clase." 
                           HorizontalOptions="Center" 
                           TextColor="Gray" 
                           Margin="0,20" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="#EFEFEF" 
                               CornerRadius="8" 
                               Padding="12" 
                               Margin="0,4" 
                               HasShadow="False" 
                               BackgroundColor="White">
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" VerticalOptions="Center">

                                <!-- Info Alumno -->
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                    <Label Text="{Binding NombreEstudiante}" 
                                           FontAttributes="Bold" 
                                           FontSize="15" 
                                           TextColor="#212121" />
                                    <Label Text="{Binding Legajo, StringFormat='Legajo: {0}'}" 
                                           FontSize="12" 
                                           TextColor="#757575" />
                                </VerticalStackLayout>

                                <!-- Interruptor Entregado / Pendiente -->
                                <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="6">
                                    <Label Text="Entregado" FontSize="12" VerticalOptions="Center" TextColor="#2E7D32" />
                                    <CheckBox IsChecked="{Binding Entregado}" Color="#2E7D32" />
                                </HorizontalStackLayout>

                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Botón de Guardado -->
            <Button Text="Guardar Entregas de TPs"
                    Command="{Binding GuardarEntregasCommand}"
                    BackgroundColor="#1976D2"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="50"
                    Margin="0,15,0,20" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>