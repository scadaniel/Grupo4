<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App_v3.Views.EstudianteListPage"
             Title="Control de Riesgo por Comisión"
             BackgroundColor="#F4F6F9">

    <!-- Estructura principal en Grid -->
    <Grid RowDefinitions="Auto, Auto, *" Padding="15">

        <!-- Fila 0: Selector General de Comisión -->
        <Frame Grid.Row="0" BorderColor="#E0E0E0" CornerRadius="10" Padding="15" HasShadow="True" Margin="0,0,0,10" BackgroundColor="White">
            <VerticalStackLayout Spacing="8">
                <Label Text="SELECCIONE LA COMISIÓN A ANALIZAR" FontSize="13" FontAttributes="Bold" TextColor="#1976D2" />
                <Picker ItemsSource="{Binding ListaComisiones}"
                        SelectedItem="{Binding ComisionSeleccionada}"
                        ItemDisplayBinding="{Binding Nombre}"
                        Title="Elija una comisión..."
                        BackgroundColor="#F9F9F9" />
            </VerticalStackLayout>
        </Frame>

        <!-- Fila 1: Título informativo -->
        <HorizontalStackLayout Grid.Row="1" Spacing="5" Margin="0,0,0,10">
            <Label Text="⚠️" FontSize="14" />
            <Label Text="Alumnos ordenados de mayor a menor gravedad de riesgo" FontSize="12" TextColor="Gray" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- Fila 2: Listado de Estudiantes -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Estudiantes}"
                        SelectedItem="{Binding EstudianteSeleccionado}"
                        SelectionMode="Single">

            <CollectionView.EmptyView>
                <Label Text="Seleccione una comisión en el menú superior para visualizar el análisis de riesgo." 
                       HorizontalOptions="Center" 
                       TextColor="Gray" 
                       Margin="0,30" 
                       HorizontalTextAlignment="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="#EFEFEF" 
                           CornerRadius="8" 
                           Padding="12" 
                           Margin="0,4" 
                           HasShadow="False" 
                           BackgroundColor="White">
                        <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto, Auto" ColumnSpacing="12" RowSpacing="4">

                            <!-- Cuadradito indicador de color de riesgo -->
                            <BoxView Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" 
                                     WidthRequest="10" 
                                     CornerRadius="4" 
                                     BackgroundColor="{Binding ColorHex}" 
                                     VerticalOptions="Fill" />

                            <!-- Datos principales del estudiante -->
                            <VerticalStackLayout Grid.Column="1" Grid.Row="0" Spacing="2">
                                <Label Text="{Binding NombreCompleto}" 
                                       FontAttributes="Bold" 
                                       FontSize="15" 
                                       TextColor="#212121" />
                                <Label Text="{Binding Legajo, StringFormat='Legajo: {0}'}" 
                                       FontSize="11" 
                                       TextColor="#757575" />
                            </VerticalStackLayout>

                            <!-- Badge de Nivel de Riesgo -->
                            <Border Grid.Column="2" Grid.Row="0" 
                                    Padding="10,6" 
                                    BackgroundColor="{Binding ColorHex}" 
                                    StrokeShape="RoundRectangle 6" 
                                    VerticalOptions="Center">
                                <Label Text="{Binding NivelRiesgoText}" 
                                       TextColor="White" 
                                       FontSize="12" 
                                       FontAttributes="Bold" 
                                       HorizontalOptions="Center" />
                            </Border>

                            <!-- Indicadores numéricos -->
                            <HorizontalStackLayout Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Spacing="15">
                                <Label Text="{Binding Inasistencias, StringFormat='Inasistencias: {0}'}" 
                                       FontSize="11" 
                                       TextColor="#D32F2F" 
                                       FontAttributes="Bold" />
                                <Label Text="{Binding TpsNoEntregados, StringFormat='TPs Pendientes: {0}'}" 
                                       FontSize="11" 
                                       TextColor="#F57C00" 
                                       FontAttributes="Bold" />
                            </HorizontalStackLayout>

                            <!-- Diagnóstico -->
                            <Label Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2"
                                   Text="{Binding Diagnostico}" 
                                   FontSize="11" 
                                   TextColor="#555" />

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>