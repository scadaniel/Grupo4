<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App_v3.Views.EstudianteListPage"
             Title="Alumnos y Riesgo Académico">

    <Grid RowDefinitions="Auto,Auto,*" Padding="12">

        <!-- BARRA DE ACCIONES PRINCIPALES -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">

            <!-- Botón Borrar Base de Datos (Rojo) -->
            <Button Grid.Column="0"
                    Text="Borrar BD" 
                    Command="{Binding ResetDatabaseCommand}" 
                    BackgroundColor="#D90429"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    Padding="12,0" />

            <!-- Botón SEED (Verde) - Alineado a la derecha -->
            <Button Grid.Column="2"
                    Text="SEED" 
                    Command="{Binding SeedEstudiantesCommand}" 
                    BackgroundColor="#2B9348"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    Padding="16,0" />
        </Grid>

        <!-- Botón secundario para refrescar la vista -->
        <Button Grid.Row="1"
                Text="Actualizar Lista" 
                Command="{Binding CargarEstudiantesCommand}" 
                BackgroundColor="#1D3557"
                TextColor="White"
                CornerRadius="8"
                Margin="0,0,0,10" />

        <!-- LISTADO DE ESTUDIANTES -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Estudiantes}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,4" Padding="12" CornerRadius="10" HasShadow="True">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">

                            <!-- Nombre y Legajo -->
                            <StackLayout Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <Label Text="{Binding Estudiante.NombreCompleto}" 
                                       FontAttributes="Bold" 
                                       FontSize="15" />
                                <Label Text="{Binding Estudiante.Legajo, StringFormat='({0})'}" 
                                       TextColor="Gray" 
                                       FontSize="13" 
                                       VerticalOptions="Center" />
                            </StackLayout>

                            <!-- Email -->
                            <Label Grid.Row="1" Grid.Column="0" 
                                   Text="{Binding Estudiante.Email}" 
                                   FontSize="12" 
                                   TextColor="DimGray" 
                                   Margin="0,2,0,4" />

                            <!-- Métricas de Rendimiento -->
                            <StackLayout Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="15">
                                <Label Text="{Binding Promedio, StringFormat='Promedio: {0:F1}'}" FontSize="12" />
                                <Label Text="{Binding PorcentajeAsistencia, StringFormat='Asistencia: {0}%'}" FontSize="12" />
                            </StackLayout>

                            <!-- Badge de Estado de Riesgo Académico -->
                            <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" 
                                    VerticalOptions="Center"
                                    Padding="10,6" 
                                    StrokeShape="RoundRectangle 6">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding EnRiesgo}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#E63946" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding EnRiesgo}" Value="False">
                                        <Setter Property="BackgroundColor" Value="#2A9D8F" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <Label TextColor="White" FontAttributes="Bold" FontSize="11">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding EnRiesgo}" Value="True">
                                            <Setter Property="Text" Value="EN RIESGO" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding EnRiesgo}" Value="False">
                                            <Setter Property="Text" Value="REGULAR" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>