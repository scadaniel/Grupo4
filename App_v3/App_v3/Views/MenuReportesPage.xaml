<?xml version="1.0" encoding="utf-8" ?>
<views:PaginaBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:App_v3.Views"
    xmlns:conv="clr-namespace:App_v3.Converters"
             x:Class="App_v3.Views.MenuReportesPage"
             Title="Reportes">
    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="Reportes" Style="{StaticResource Titulo}" />
        <Label Text="Elija el reporte que quiere ver. Se arma con la materia y la comisión elegidas." Style="{StaticResource Detalle}" />
        <Button Text="Reporte de asistencias" Command="{Binding IrAsistenciasCommand}" />
        <Button Text="Reporte de entregas de trabajos prácticos" Command="{Binding IrEntregasCommand}" />
    </VerticalStackLayout>
</views:PaginaBase>
