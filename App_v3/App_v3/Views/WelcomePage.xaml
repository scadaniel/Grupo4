<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App_v3.Views.WelcomePage"
             NavigationPage.HasNavigationBar="False">

    <!-- Grid para superponer la imagen de fondo y los textos -->
    <Grid>
        <!-- 1. IMAGEN DE FONDO (Asegúrate de cambiar 'fondo_escuela.png' por el nombre de tu archivo) -->
        <Image Source="fondo2.png" 
               Aspect="AspectFill" />

        <!-- 2. CAPA OSCURA SEMITRANSPARENTE (Opcional, ayuda a que se lea mejor el texto encima de la imagen) -->
        <BoxView BackgroundColor="#0F172A" 
                 Opacity="0.8" />

        <!-- 3. CONTENIDO / TEXTOS CENTRADOS -->
        <VerticalStackLayout VerticalOptions="Center" 
                             HorizontalOptions="Center" 
                             Spacing="20" 
                             Padding="40">

            <!-- Títulos institucionales -->
            <Label Text="Sistema de Alerta Temprana" 
                   TextColor="White" 
                   FontSize="35" 
                   FontAttributes="Bold" 
                   HorizontalTextAlignment="Center"/>

            <Label Text="Gestión académica, toma de asistencias, control de entrega de TPs y seguimiento de estudiantes." 
                   TextColor="#94A3B8" 
                   FontSize="25" 
                   HorizontalTextAlignment="Center"
                   MaximumWidthRequest="350"/>

            <!-- Línea divisoria y créditos del Grupo 4 -->
            <BoxView HeightRequest="1" 
                     BackgroundColor="#334155" 
                     WidthRequest="150" 
                     Margin="0,20,0,5"
                     HorizontalOptions="Center"/>

            <Label Text="Desarrollado por Grupo 4:" 
                   TextColor="#64748B" 
                   FontSize="20" 
                   HorizontalTextAlignment="Center"/>

            <Label Text="Eleonora • Mariana • Alan • Julio • Daniel" 
                   TextColor="#38BDF8" 
                   FontSize="20" 
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"/>

        </VerticalStackLayout>
    </Grid>
</ContentPage>