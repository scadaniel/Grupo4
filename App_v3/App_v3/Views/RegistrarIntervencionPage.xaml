<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:App_v3.ViewModels"
             x:Class="App_v3.Views.RegistrarIntervencionPage"
             Title="Registrar Contacto"
             BackgroundColor="#F4F6F9">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- 🌟 SECCIÓN / TARJETA CON LOS DATOS DEL ESTUDIANTE -->
            <Frame BorderColor="#3B82F6" 
                   CornerRadius="12" 
                   Padding="15" 
                   HasShadow="True" 
                   BackgroundColor="#1E293B">
                <VerticalStackLayout Spacing="4">
                    <Label Text="REGISTRAR SEGUIMIENTO PARA:" 
                           FontSize="11" 
                           FontAttributes="Bold" 
                           TextColor="#94A3B8" />
                    <Label Text="{Binding NombreEstudiante}" 
                           FontSize="20" 
                           FontAttributes="Bold" 
                           TextColor="White" />
                    <Label Text="{Binding DetalleEstudiante}" 
                           FontSize="13" 
                           TextColor="#CBD5E1" />
                </VerticalStackLayout>
            </Frame>

            <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" Margin="0,5" />

            <!-- Formulario de Intervención -->
            <Label Text="Detalles de la Intervención"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="#1A252C" />

            <!-- Selector de Fecha -->
            <Label Text="Fecha de Intervención:" FontAttributes="Bold" TextColor="#334155" />
            <DatePicker Date="{Binding FechaIntervencion}"
                        Format="dd/MM/yyyy"
                        MaximumDate="{x:Static sys:DateTime.Today}"
                        xmlns:sys="clr-namespace:System;assembly=mscorlib"
                        BackgroundColor="White" />

            <!-- Selector de Medio -->
            <Label Text="Medio de Contacto:" FontAttributes="Bold" TextColor="#334155" />
            <Picker Title="Seleccionar medio"
                    ItemsSource="{Binding MediosDisponibles}"
                    SelectedItem="{Binding MedioSeleccionado}"
                    BackgroundColor="White" />

            <!-- Editor de Resultado / Notas -->
            <Label Text="Resultado / Acuerdos alcanzados:" FontAttributes="Bold" TextColor="#334155" />
            <Editor Text="{Binding ResultadoNotas}"
                    Placeholder="Escribe aquí las observaciones, respuesta del alumno o compromisos alcanzados..."
                    HeightRequest="120"
                    BackgroundColor="White"
                    AutoSize="Disabled" />

            <!-- Botón de Guardado -->
            <Button Text="💾 Guardar Intervención"
                    Command="{Binding RegistrarContactoCommand}"
                    BackgroundColor="#2E7D32"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    Margin="0,15,0,20"
                    HeightRequest="50" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>