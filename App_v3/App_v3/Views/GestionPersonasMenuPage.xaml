<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App_v3.Views.GestionPersonasMenuPage"
             Title="Panel de Gestión de Personas"
             BackgroundColor="#F4F6F9">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20" VerticalOptions="Center">

            <!-- Encabezado -->
            <VerticalStackLayout Spacing="5" HorizontalOptions="Center" Margin="0,0,0,10">
                <Label Text="👥 Gestión de Personas" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       TextColor="#1A252C" 
                       HorizontalOptions="Center" />
                <Label Text="Seleccione el sector o acción que desea realizar" 
                       FontSize="14" 
                       TextColor="#757575" 
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Tarjeta 1: Listado, Filtros y Estado -->
            <Frame BorderColor="#E0E0E0" 
                   CornerRadius="12" 
                   Padding="20" 
                   HasShadow="True" 
                   BackgroundColor="White">
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                    <!-- Indicador lateral -->
                    <BoxView Grid.Column="0" WidthRequest="8" CornerRadius="4" BackgroundColor="#1976D2" VerticalOptions="Fill" />

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                        <Label Text="Listado y Filtros" FontSize="16" FontAttributes="Bold" TextColor="#212121" />
                        <Label Text="Búsqueda por DNI y apellido, control de estado activo/inactivo y asignación a comisiones." FontSize="12" TextColor="#666" />
                    </VerticalStackLayout>

                    <Button Grid.Column="2" 
                            Text="Ver" 
                            Command="{Binding IrAListadoCommand}"
                            BackgroundColor="#1976D2" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            CornerRadius="8" 
                            VerticalOptions="Center" 
                            HeightRequest="40" 
                            WidthRequest="80" />
                </Grid>
            </Frame>

            <!-- Tarjeta 2: Consulta por Comisiones -->
            <Frame BorderColor="#E0E0E0" 
                   CornerRadius="12" 
                   Padding="20" 
                   HasShadow="True" 
                   BackgroundColor="White">
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                    <!-- Indicador lateral -->
                    <BoxView Grid.Column="0" WidthRequest="8" CornerRadius="4" BackgroundColor="#2E7D32" VerticalOptions="Fill" />

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                        <Label Text="Nómina por Comisión" FontSize="16" FontAttributes="Bold" TextColor="#212121" />
                        <Label Text="Seleccione una comisión para visualizar la nómina exacta de alumnos inscriptos." FontSize="12" TextColor="#666" />
                    </VerticalStackLayout>

                    <Button Grid.Column="2" 
                            Text="Ver" 
                            Command="{Binding IrAComisionesCommand}"
                            BackgroundColor="#2E7D32" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            CornerRadius="8" 
                            VerticalOptions="Center" 
                            HeightRequest="40" 
                            WidthRequest="80" />
                </Grid>
            </Frame>

            <!-- Tarjeta 3: Alta de Nuevo Estudiante -->
            <Frame BorderColor="#E0E0E0" 
                   CornerRadius="12" 
                   Padding="20" 
                   HasShadow="True" 
                   BackgroundColor="White">
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                    <!-- Indicador lateral -->
                    <BoxView Grid.Column="0" WidthRequest="8" CornerRadius="4" BackgroundColor="#E65100" VerticalOptions="Fill" />

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                        <Label Text="Registro / Alta" FontSize="16" FontAttributes="Bold" TextColor="#212121" />
                        <Label Text="Formulario limpio para dar de alta a nuevos estudiantes en la base de datos." FontSize="12" TextColor="#666" />
                    </VerticalStackLayout>

                    <Button Grid.Column="2" 
                            Text="Ver" 
                            Command="{Binding IrANuevoEstudianteCommand}"
                            BackgroundColor="#E65100" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            CornerRadius="8" 
                            VerticalOptions="Center" 
                            HeightRequest="40" 
                            WidthRequest="80" />
                </Grid>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>