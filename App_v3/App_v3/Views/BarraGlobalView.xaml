<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App_v3.Views.BarraGlobalView">

<Grid ColumnDefinitions="Auto,Auto,*,Auto,*,Auto,Auto,Auto"
          ColumnSpacing="8"
          Padding="12,4"
          VerticalOptions="Center">

        <!-- 1. Isotipo Institucional -->
        <VerticalStackLayout Grid.Column="0"
                            VerticalOptions="Center"
                            Margin="0,0,8,0"
                            Spacing="-7">
            <Border BackgroundColor="#2B0B98"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="10,2"
                    HorizontalOptions="Center">
                <Label Text="Gestión Institucional"
                       TextColor="White"
                       FontSize="11"
                       FontAttributes="Bold"/>
            </Border>
            <Border BackgroundColor="White"
                    Stroke="#2B0B98"
                    StrokeThickness="1.2"
                    StrokeShape="RoundRectangle 8"
                    Padding="8,1,8,2"
                    HorizontalOptions="Center"
                    ZIndex="-1">
                <Label Text="de Estudiantes"
                       TextColor="#2B0B98"
                       FontSize="12"
                       FontAttributes="Bold"/>
            </Border>
        </VerticalStackLayout>

        <!-- 2. Materia -->
        <Label Grid.Column="1"
               Text="Materia"
               Style="{StaticResource EtiquetaBarra}"/>
        <Grid Grid.Column="2"
              VerticalOptions="Center">
            <Picker ItemsSource="{Binding Materias}"
                    ItemDisplayBinding="{Binding Nombre}"
                    SelectedItem="{Binding MateriaSeleccionada}"
                    IsEnabled="{Binding HayMateria}"
                    TextColor="{StaticResource Gray900}"
                    TitleColor="{StaticResource Gray500}"
                    HeightRequest="32"
                    MinimumHeightRequest="32"/>
            <Label Text="Sin materias"
                   Style="{StaticResource MarcadorPicker}"
                   IsVisible="{Binding SinMateria}"/>
        </Grid>

        <!-- 3. Comisión -->
        <Label Grid.Column="3"
               Text="Comisión"
               Style="{StaticResource EtiquetaBarra}"/>
        <Grid Grid.Column="4"
              VerticalOptions="Center">
            <Picker ItemsSource="{Binding Comisiones}"
                    ItemDisplayBinding="{Binding Nombre}"
                    SelectedItem="{Binding ComisionSeleccionada}"
                    IsEnabled="{Binding HayComision}"
                    TextColor="{StaticResource Gray900}"
                    TitleColor="{StaticResource Gray500}"
                    HeightRequest="32"
                    MinimumHeightRequest="32"/>
            <Label Text="Sin comisiones"
                   Style="{StaticResource MarcadorPicker}"
                   IsVisible="{Binding SinComision}"/>
        </Grid>

        <!-- 4. Reportes -->
        <Button Grid.Column="5"
                Text="Reportes"
                Style="{StaticResource BotonTexto}"
                Clicked="AlIrAReportes" />

        <!-- 5. Configuración -->
        <Button Grid.Column="6"
                Text="Configuración"
                Style="{StaticResource BotonTexto}"
                Clicked="AlIrAConfiguracion" />

        <!-- 6. Salir -->
        <Button Grid.Column="7"
                Text="⋮"
                FontSize="18"
                FontAttributes="Bold"
                Style="{StaticResource BotonTexto}"
                Clicked="AlPresionarOpciones"
                WidthRequest="32"
                HeightRequest="32"
                Padding="0" />
    </Grid>
</ContentView>