<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:App_v3.Models"
             xmlns:vm="clr-namespace:App_v3.ViewModels"
             x:Class="App_v3.Views.GestionClasesPage"
             Title="Gestión de Clases y Cátedras"
             BackgroundColor="#0F172A"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">

        <!-- BARRA SUPERIOR -->
        <Grid Grid.Row="0" BackgroundColor="#1E293B" Padding="20,15" ColumnDefinitions="Auto, *, Auto">
            <Button Grid.Column="0"
                    Text="☰ Menú" 
                    BackgroundColor="#3B82F6" 
                    TextColor="White"
                    FontSize="18"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="50"
                    WidthRequest="120"
                    VerticalOptions="Center"
                    Clicked="OnBotonMenuFlyoutClicked" />
            <Label Grid.Column="1" 
                   Text="Gestión de Clases" 
                   TextColor="White" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center" 
                   Margin="20,0,0,0" />
        </Grid>

        <!-- CONTENIDO SCROLLABLE -->
        <ScrollView Grid.Row="1" BackgroundColor="#F4F6F9">
            <VerticalStackLayout Padding="20" Spacing="15">

                <Label Text="Registrar Nueva Cátedra / Clase"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#1A252C" />

                <!-- Nombre de la Materia -->
                <Entry Placeholder="Nombre de la Materia (ej. Física 2)"
                       Text="{Binding NombreMateria}"
                       BackgroundColor="White" />

                <!-- Selector de Comisión (Picker) -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Asignar Comisión" FontSize="14" FontAttributes="Bold" TextColor="#2C3E50" />
                    <Picker ItemsSource="{Binding ListaComisiones}"
                            SelectedItem="{Binding ComisionSeleccionada}"
                            ItemDisplayBinding="{Binding Nombre}"
                            Title="Elija una comisión..."
                            FontSize="15"
                            BackgroundColor="White" />
                </VerticalStackLayout>

                <Button Text="Guardar Clase"
                        Command="{Binding GuardarClaseCommand}"
                        BackgroundColor="#512BD4"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="45" />

                <BoxView HeightRequest="1" Color="Gray" Margin="0,10" />

                <Label Text="Clases Registradas"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#1A252C" />

                <CollectionView ItemsSource="{Binding Clases}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Clase">
                            <Frame Margin="0,5" Padding="10" BackgroundColor="White" BorderColor="#E0E0E0">
                                <VerticalStackLayout>
                                    <Label Text="{Binding NombreMateria}" FontAttributes="Bold" FontSize="16" TextColor="#212121" />
                                    <Label Text="{Binding Comision, StringFormat='Comisión: {0}'}" FontSize="14" TextColor="Gray" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>