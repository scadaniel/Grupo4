<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:App_v3.Models"
             x:Class="App_v3.Views.GestionClasesPage"
             Title="Gestión de Clases y Cátedras"
             BackgroundColor="#0F172A"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">

        <!-- BARRA SUPERIOR -->
        <Grid Grid.Row="0" BackgroundColor="#1E293B" Padding="20,15" ColumnDefinitions="Auto, *, Auto">
            <Button Grid.Column="0"
                    Text="☰ Menú" 
                    BackgroundColor="#3B82F6" 
                    TextColor="White"
                    FontSize="18"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="50"
                    WidthRequest="120"
                    VerticalOptions="Center"
                    Clicked="OnBotonMenuFlyoutClicked" />
            <Label Grid.Column="1" 
                   Text="Gestión de Clases" 
                   TextColor="White" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center" 
                   Margin="20,0,0,0" />
        </Grid>

        <!-- CONTENIDO SCROLLABLE -->
        <ScrollView Grid.Row="1" BackgroundColor="#F4F6F9">
            <VerticalStackLayout Padding="20" Spacing="12">

                <Label Text="Registrar Nueva Cátedra / Clase"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#1A252C" />

                <Entry Placeholder="Nombre de la Materia (ej. Física 2)"
                       Text="{Binding NombreMateria}"
                       BackgroundColor="White" />

                <Entry Placeholder="Comisión (ej. Comisión A)"
                       Text="{Binding ComisionInput}"
                       BackgroundColor="White" />

                <Entry Placeholder="Nombre del Profesor"
                       Text="{Binding NombreProfesor}"
                       BackgroundColor="White" />

                <Entry Placeholder="DNI del Profesor"
                       Text="{Binding DniProfesor}"
                       Keyboard="Numeric"
                       BackgroundColor="White" />

                <Entry Placeholder="Teléfono del Profesor"
                       Text="{Binding TelefonoProfesor}"
                       Keyboard="Telephone"
                       BackgroundColor="White" />

                <Button Text="Guardar Clase"
                        Command="{Binding GuardarClaseCommand}"
                        BackgroundColor="#512BD4"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="45"
                        Margin="0,5,0,0" />

                <BoxView HeightRequest="1" Color="Gray" Margin="0,10" />

                <Label Text="Clases Registradas"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#1A252C" />

                <!-- LISTADO DE CLASES -->
                <CollectionView ItemsSource="{Binding Clases}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Clase">
                            <Frame Margin="0,5" Padding="12" BackgroundColor="White" BorderColor="#E0E0E0">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="{Binding NombreMateria}" FontAttributes="Bold" FontSize="16" TextColor="#212121" />
                                    <Label Text="{Binding Comision, StringFormat='Comisión: {0}'}" FontSize="14" FontAttributes="Bold" TextColor="#1976D2" />
                                    <Label Text="{Binding NombreProfesor, StringFormat='Profesor: {0}'}" FontSize="13" TextColor="#424242" />
                                    <Label Text="{Binding TelefonoProfesor, StringFormat='Tel: {0}'}" FontSize="12" TextColor="Gray" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>