<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App_v3.Views.ListadoEstudiantesPage"
             Title="Listado y Filtros de Estudiantes"
             BackgroundColor="#F4F6F9">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Botón Volver -->
            <Button Text="⬅️ Volver al Menú"
                    Command="{Binding VolverAlMenuCommand}"
                    BackgroundColor="#78909C"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="40"
                    HorizontalOptions="Start"
                    WidthRequest="150" />

            <!-- Tarjeta de Filtros -->
            <Frame BorderColor="#E0E0E0" CornerRadius="12" Padding="15" HasShadow="True" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Criterios de Búsqueda" FontSize="15" FontAttributes="Bold" TextColor="#1A252C" />

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <Entry Grid.Column="0" 
                               Placeholder="Filtrar por Apellido..." 
                               Text="{Binding FiltroApellido}" 
                               FontSize="14" />
                        <Entry Grid.Column="1" 
                               Placeholder="Filtrar por DNI..." 
                               Text="{Binding FiltroDni}" 
                               Keyboard="Numeric" 
                               FontSize="14" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Lista de Estudiantes -->
            <CollectionView ItemsSource="{Binding ListaEstudiantesFiltrada}">
                <CollectionView.EmptyView>
                    <Label Text="No se encontraron estudiantes con los filtros especificados." 
                           HorizontalOptions="Center" 
                           TextColor="Gray" 
                           Margin="0,20" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="#EFEFEF" CornerRadius="10" Padding="15" Margin="0,5" HasShadow="False" BackgroundColor="White">
                            <VerticalStackLayout Spacing="10">

                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding NombreCompleto}" FontAttributes="Bold" FontSize="16" TextColor="#212121" />
                                        <Label Text="{Binding Email}" FontSize="12" TextColor="#757575" />
                                        <Label Text="{Binding Legajo, StringFormat='Legajo: {0}'}" FontSize="12" TextColor="#1976D2" FontAttributes="Bold" />
                                    </VerticalStackLayout>

                                    <!-- Switch Activo / Inactivo con OnColor para .NET 10 -->
                                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center" Spacing="2">
                                        <Label Text="Activo" FontSize="11" TextColor="Gray" HorizontalOptions="Center" />
                                        <Switch IsToggled="{Binding Activo}" OnColor="#2E7D32" />
                                    </VerticalStackLayout>
                                </Grid>

                                <BoxView HeightRequest="1" BackgroundColor="#E0E0E0" Margin="0,2" />

                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                    <Picker Grid.Column="0"
                                            ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ListaComisiones}"
                                            SelectedItem="{Binding ComisionSeleccionada}"
                                            Title="Asignar a comisión..."
                                            FontSize="13"
                                            ItemDisplayBinding="{Binding Nombre}" />

                                    <Button Grid.Column="1"
                                            Text="Inscribir"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.InscribirComisionCommand}"
                                            CommandParameter="{Binding}"
                                            BackgroundColor="#1976D2"
                                            TextColor="White"
                                            FontSize="12"
                                            HeightRequest="36"
                                            CornerRadius="6" />
                                </Grid>

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>