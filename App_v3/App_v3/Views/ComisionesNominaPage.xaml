<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App_v3.Views.ComisionesNominaPage"
             Title="Nómina por Comisión"
             BackgroundColor="#F4F6F9">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Botón Volver -->
            <Button Text="⬅️ Volver al Menú"
                    Command="{Binding VolverAlMenuCommand}"
                    BackgroundColor="#78909C"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="40"
                    HorizontalOptions="Start"
                    WidthRequest="150" />

            <!-- Selector de Comisión -->
            <Frame BorderColor="#E0E0E0" CornerRadius="12" Padding="15" HasShadow="True" BackgroundColor="White">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Seleccionar Comisión" 
                           FontSize="15" 
                           FontAttributes="Bold" 
                           TextColor="#1A252C" />

                    <Picker ItemsSource="{Binding ListaComisiones}"
                            SelectedItem="{Binding ComisionActualSeleccionada}"
                            ItemDisplayBinding="{Binding Nombre}"
                            Title="Elija una comisión..."
                            FontSize="15"
                            BackgroundColor="#FFFFFF" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="Alumnos Inscriptos" 
                   FontSize="16" 
                   FontAttributes="Bold" 
                   TextColor="#1A252C" 
                   Margin="0,5,0,0" />

            <!-- Nómina -->
            <CollectionView ItemsSource="{Binding AlumnosDeComisionSeleccionada}">
                <CollectionView.EmptyView>
                    <Label Text="Seleccione una comisión para ver su nómina o no hay alumnos inscriptos." 
                           HorizontalOptions="Center" 
                           TextColor="Gray" 
                           Margin="0,20" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="#EFEFEF" CornerRadius="10" Padding="12" Margin="0,3" HasShadow="False" BackgroundColor="White">
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding NombreCompleto}" FontAttributes="Bold" FontSize="15" TextColor="#212121" />
                                    <Label Text="{Binding Legajo, StringFormat='Legajo: {0}'}" FontSize="12" TextColor="Gray" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding EstadoAlerta}" FontSize="12" FontAttributes="Bold" TextColor="#D32F2F" VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>