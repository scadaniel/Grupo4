<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App_v3.Views.ConfiguracionPage"
             Title="Configuración de Umbrales">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Parámetros de Riesgo (H7)" FontSize="20" FontAttributes="Bold" />
            <Label Text="Seleccione la comisión y defina los límites numéricos a partir de los cuales el sistema clasificará a los estudiantes en riesgo Medio o Alto." 
                   TextColor="Gray" FontSize="14" />

            <!-- Sección Selector de Comisión -->
            <Border Padding="15" StrokeShape="RoundRectangle 8" BackgroundColor="#FFFFFF" Stroke="#E0E0E0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="SELECCIONE LA COMISIÓN A CONFIGURAR" FontAttributes="Bold" FontSize="15" TextColor="#1976D2" />

                    <Picker ItemsSource="{Binding ListaComisiones}"
                            SelectedItem="{Binding ComisionSeleccionada}"
                            ItemDisplayBinding="{Binding Nombre}"
                            Title="Elija una comisión..."
                            FontSize="15"
                            BackgroundColor="#F9F9F9" />
                </VerticalStackLayout>
            </Border>

            <!-- Sección Inasistencias -->
            <Border Padding="15" StrokeShape="RoundRectangle 8" BackgroundColor="#F9F9F9">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Criterio de Inasistencias" FontAttributes="Bold" FontSize="16" />

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="Límite para Riesgo BAJO (hasta):" VerticalOptions="Center" WidthRequest="220" />
                        <Entry Text="{Binding InasistenciasBajo}" Keyboard="Numeric" WidthRequest="80" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="Límite para Riesgo MEDIO (hasta):" VerticalOptions="Center" WidthRequest="220" />
                        <Entry Text="{Binding InasistenciasMedio}" Keyboard="Numeric" WidthRequest="80" />
                    </HorizontalStackLayout>
                    <Label Text="* Superar el límite medio asignará automáticamente Riesgo ALTO." FontSize="12" TextColor="DarkGray" />
                </VerticalStackLayout>
            </Border>

            <!-- Sección Trabajos Prácticos -->
            <Border Padding="15" StrokeShape="RoundRectangle 8" BackgroundColor="#F9F9F9">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Criterio de Trabajos Prácticos No Entregados" FontAttributes="Bold" FontSize="16" />

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="Límite para Riesgo BAJO (hasta):" VerticalOptions="Center" WidthRequest="220" />
                        <Entry Text="{Binding TpsBajo}" Keyboard="Numeric" WidthRequest="80" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="Límite para Riesgo MEDIO (hasta):" VerticalOptions="Center" WidthRequest="220" />
                        <Entry Text="{Binding TpsMedio}" Keyboard="Numeric" WidthRequest="80" />
                    </HorizontalStackLayout>
                    <Label Text="* Superar el límite medio asignará automáticamente Riesgo ALTO." FontSize="12" TextColor="DarkGray" />
                </VerticalStackLayout>
            </Border>

            <!-- Botón Guardar -->
            <Button Text="Guardar Configuración de Umbrales" 
                    Command="{Binding GuardarCommand}"
                    BackgroundColor="DarkBlue"
                    TextColor="White"
                    CornerRadius="8"
                    Margin="0,10,0,0" />

            <!-- 🛠️ Botón Restablecer / Borrar Base de Datos -->
            <Button Text="Restablecer / Borrar Base de Datos" 
                    Command="{Binding ResetDatabaseCommand}"
                    BackgroundColor="#D32F2F"
                    TextColor="White"
                    CornerRadius="8"
                    Margin="0,5,0,20" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>